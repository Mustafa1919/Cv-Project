{
  "name": "vitrin-content-tool",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "gen:types": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/gen-types.ts",
    "typecheck": "npm run gen:types && tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/run-tests.ts",
    "check": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts check",
    "approve": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts approve"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "22.20.5",
    "json-schema-to-typescript": "16.0.0"
  }
}
