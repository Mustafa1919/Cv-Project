{
  "name": "vitrin-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "astro dev",
    "typecheck": "npm run gen:types --workspace vitrin-content-tool && astro check",
    "build": "astro build && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/write-headers.ts && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-pdf.ts",
    "serve": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/serve.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/run-e2e.ts"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "astro": "7.3.6",
    "marked": "18.1.0",
    "vitrin-content-tool": "*",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@cantoo/pdf-lib": "2.11.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "pdfjs-dist": "6.4.299",
    "typescript": "6.0.3"
  }
}
